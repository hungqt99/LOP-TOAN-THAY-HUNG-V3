# =================================================================
# Lớp Toán Thầy Hùng - Environment Configuration Example
# =================================================================

# Cổng khởi chạy ứng dụng (Mặc định: 3000)
PORT=3000

# Môi trường chạy (development | production)
NODE_ENV=production

# Khóa Google Gemini API (Dùng cho tính năng AI Chấm điểm tự luận & Giải thích chi tiết)
# Lấy khóa miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Web App - tạo project Firebase riêng cho app của thầy
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=

# Địa chỉ URL công khai của ứng dụng (Nếu cần cho webhook/tích hợp)
APP_URL=https://your-domain.com
